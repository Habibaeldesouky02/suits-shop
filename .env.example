# Add these in Cloudflare → your Worker → Settings → Variables and Secrets (use type "Secret" for keys).
# To test locally with `npm run preview`, copy this file to .dev.vars.
# Orders are sent to every channel you set up below (WhatsApp, email, or both).

# --- Customers send their order to your WhatsApp (free, no service needed) ---
# After ordering, the customer gets a button that opens WhatsApp with the order typed in.
# Your WhatsApp number in international format, e.g. 491701234567 or 201001234567
SHOP_WHATSAPP_NUMBER=201001234567

# --- New orders on your WhatsApp: Whatabot (free, messages to yourself) ---
# Your WhatsApp number, e.g. 201001234567 (01001234567 also works)
# WHATABOT_PHONE=201001234567
# The API key the Whatabot bot sent you on WhatsApp
# WHATABOT_APIKEY=...

# --- ...or CallMeBot (free, messages to yourself). If both are set, Whatabot is used. ---
# Your WhatsApp number, e.g. +201001234567 (01001234567 also works)
# CALLMEBOT_PHONE=+201001234567
# The API key the CallMeBot bot sent you on WhatsApp
# CALLMEBOT_APIKEY=123456

# --- New orders by email (optional, Resend: https://resend.com → API Keys) ---
# RESEND_API_KEY=re_...
# Without a verified domain in Resend, this must be the email you signed up to Resend with.
# ORDER_EMAIL_TO=you@example.com
# Once your domain (e.g. fastsuit.com) is verified in Resend:
# ORDER_EMAIL_FROM=Fast Suit <orders@fastsuit.com>
# SEND_CUSTOMER_EMAILS=true

# Your public website address (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://fastsuit.com
