# Copy this file to .env.local (on your computer) or add these in Vercel → Settings → Environment Variables.
# Orders are sent to every channel you set up below (WhatsApp, email, or both).

# --- New orders on your WhatsApp (CallMeBot, free for messages to yourself) ---
# Your WhatsApp number, e.g. +201001234567 (01001234567 also works)
CALLMEBOT_PHONE=+201001234567
# The API key the CallMeBot bot sent you on WhatsApp
CALLMEBOT_APIKEY=123456

# --- New orders by email (optional, Resend: https://resend.com → API Keys) ---
# RESEND_API_KEY=re_...
# Without a verified domain in Resend, this must be the email you signed up to Resend with.
# ORDER_EMAIL_TO=you@example.com
# Once your domain (e.g. fastsuit.com) is verified in Resend:
# ORDER_EMAIL_FROM=Fast Suit <orders@fastsuit.com>
# SEND_CUSTOMER_EMAILS=true

# Your public website address (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://fastsuit.com
