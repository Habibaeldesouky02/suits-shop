# Copy this file to .env.local and fill in your own keys.
# Stripe keys: https://dashboard.stripe.com/test/apikeys (use test keys while developing)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or from the webhook endpoint in the Stripe Dashboard in production
STRIPE_WEBHOOK_SECRET=whsec_...
# Your public website address (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
