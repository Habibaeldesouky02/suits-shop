# Copy this file to .env.local (on your computer) or add these in Vercel → Settings → Environment Variables.

# Order emails are sent with Resend: create a free account at https://resend.com → API Keys
RESEND_API_KEY=re_...
# Where new orders are sent. Without a verified domain in Resend, this must be the email you signed up to Resend with.
ORDER_EMAIL_TO=you@example.com

# Optional, once you have verified your domain (e.g. fastsuit.com) in Resend:
# ORDER_EMAIL_FROM=Fast Suit <orders@fastsuit.com>
# SEND_CUSTOMER_EMAILS=true

# Your public website address (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://fastsuit.com
